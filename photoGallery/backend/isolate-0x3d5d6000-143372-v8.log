code-creation,Eval,9,355489,0x36a23b794d78,5, /home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/controllers/imageController.js:1:1,0x2aa26bced9f8,~
script-source,384,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/controllers/imageController.js,const imageService = require("../services/imageService");\n\n// Get all images\nconst getAllImages = async (req\x2C res\x2C next) => {\n  try {\n    let { pageName\x2C pageSize\x2C sort } = req.data; //get data from pageValidation\n    const images = await imageService.getAllImages(pageName\x2C pageSize\x2C sort);\n    res.status(200).json(images.rows);\n  } catch (err) {\n    next(err);\n    // console.error(err);\n    // res.status(500).send("Error pagination ");\n  }\n};\n\n// Upload Image\nconst uploadImage = async (req\x2C res\x2C next) => {\n  try {\n    //fieldname \x2C originalname \x2C encoding 7bit \x2C mimetype \x2C buffer\n    const { originalname\x2C mimetype\x2C buffer } = req.file;\n    const result = await imageService.uploadImage(\n      originalname\x2C\n      mimetype\x2C\n      buffer\n    );\n    res\n      .status(201)\n      .json({ message: "Image uploaded successfully"\x2C image: result.rows[0] });\n  } catch (err) {\n    next(err);\n  }\n};\n\n// Delete Image\nconst deleteImage = async (req\x2C res\x2C next) => {\n  try {\n    // console.log(req.params);\n    const { id } = req.params;\n    const result = await imageService.deleteImage(id);\n    res.status(200).json({ message: "Image deleted successfully" });\n  } catch (err) {\n    next(err);\n  }\n};\n\n// Get single image\nconst getImage = async (req\x2C res\x2C next) => {\n  try {\n    const image = req.image; //get data from middleware\n    res.set("Content-Type"\x2C image.type);\n    res.send(image.data);\n  } catch (err) {\n    next(err);\n  }\n};\n\nmodule.exports = { getAllImages\x2C uploadImage\x2C deleteImage\x2C getImage };\n
