script-source,343,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/node_modules/color/node_modules/color-convert/index.js,var conversions = require('./conversions');\nvar route = require('./route');\n\nvar convert = {};\n\nvar models = Object.keys(conversions);\n\nfunction wrapRaw(fn) {\n\x09var wrappedFn = function (args) {\n\x09\x09if (args === undefined || args === null) {\n\x09\x09\x09return args;\n\x09\x09}\n\n\x09\x09if (arguments.length > 1) {\n\x09\x09\x09args = Array.prototype.slice.call(arguments);\n\x09\x09}\n\n\x09\x09return fn(args);\n\x09};\n\n\x09// preserve .conversion property if there is one\n\x09if ('conversion' in fn) {\n\x09\x09wrappedFn.conversion = fn.conversion;\n\x09}\n\n\x09return wrappedFn;\n}\n\nfunction wrapRounded(fn) {\n\x09var wrappedFn = function (args) {\n\x09\x09if (args === undefined || args === null) {\n\x09\x09\x09return args;\n\x09\x09}\n\n\x09\x09if (arguments.length > 1) {\n\x09\x09\x09args = Array.prototype.slice.call(arguments);\n\x09\x09}\n\n\x09\x09var result = fn(args);\n\n\x09\x09// we're assuming the result is an array here.\n\x09\x09// see notice in conversions.js; don't use box types\n\x09\x09// in conversion functions.\n\x09\x09if (typeof result === 'object') {\n\x09\x09\x09for (var len = result.length\x2C i = 0; i < len; i++) {\n\x09\x09\x09\x09result[i] = Math.round(result[i]);\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09return result;\n\x09};\n\n\x09// preserve .conversion property if there is one\n\x09if ('conversion' in fn) {\n\x09\x09wrappedFn.conversion = fn.conversion;\n\x09}\n\n\x09return wrappedFn;\n}\n\nmodels.forEach(function (fromModel) {\n\x09convert[fromModel] = {};\n\n\x09Object.defineProperty(convert[fromModel]\x2C 'channels'\x2C {value: conversions[fromModel].channels});\n\x09Object.defineProperty(convert[fromModel]\x2C 'labels'\x2C {value: conversions[fromModel].labels});\n\n\x09var routes = route(fromModel);\n\x09var routeModels = Object.keys(routes);\n\n\x09routeModels.forEach(function (toModel) {\n\x09\x09var fn = routes[toModel];\n\n\x09\x09convert[fromModel][toModel] = wrapRounded(fn);\n\x09\x09convert[fromModel][toModel].raw = wrapRaw(fn);\n\x09});\n});\n\nmodule.exports = convert;\n
