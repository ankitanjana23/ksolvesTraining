script-source,344,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/node_modules/color/node_modules/color-convert/conversions.js,/* MIT license */\nvar cssKeywords = require('color-name');\n\n// NOTE: conversions should only return primitive values (i.e. arrays\x2C or\n//       values that give correct `typeof` results).\n//       do not use box values types (i.e. Number()\x2C String()\x2C etc.)\n\nvar reverseKeywords = {};\nfor (var key in cssKeywords) {\n\x09if (cssKeywords.hasOwnProperty(key)) {\n\x09\x09reverseKeywords[cssKeywords[key]] = key;\n\x09}\n}\n\nvar convert = module.exports = {\n\x09rgb: {channels: 3\x2C labels: 'rgb'}\x2C\n\x09hsl: {channels: 3\x2C labels: 'hsl'}\x2C\n\x09hsv: {channels: 3\x2C labels: 'hsv'}\x2C\n\x09hwb: {channels: 3\x2C labels: 'hwb'}\x2C\n\x09cmyk: {channels: 4\x2C labels: 'cmyk'}\x2C\n\x09xyz: {channels: 3\x2C labels: 'xyz'}\x2C\n\x09lab: {channels: 3\x2C labels: 'lab'}\x2C\n\x09lch: {channels: 3\x2C labels: 'lch'}\x2C\n\x09hex: {channels: 1\x2C labels: ['hex']}\x2C\n\x09keyword: {channels: 1\x2C labels: ['keyword']}\x2C\n\x09ansi16: {channels: 1\x2C labels: ['ansi16']}\x2C\n\x09ansi256: {channels: 1\x2C labels: ['ansi256']}\x2C\n\x09hcg: {channels: 3\x2C labels: ['h'\x2C 'c'\x2C 'g']}\x2C\n\x09apple: {channels: 3\x2C labels: ['r16'\x2C 'g16'\x2C 'b16']}\x2C\n\x09gray: {channels: 1\x2C labels: ['gray']}\n};\n\n// hide .channels and .labels properties\nfor (var model in convert) {\n\x09if (convert.hasOwnProperty(model)) {\n\x09\x09if (!('channels' in convert[model])) {\n\x09\x09\x09throw new Error('missing channels property: ' + model);\n\x09\x09}\n\n\x09\x09if (!('labels' in convert[model])) {\n\x09\x09\x09throw new Error('missing channel labels property: ' + model);\n\x09\x09}\n\n\x09\x09if (convert[model].labels.length !== convert[model].channels) {\n\x09\x09\x09throw new Error('channel and label counts mismatch: ' + model);\n\x09\x09}\n\n\x09\x09var channels = convert[model].channels;\n\x09\x09var labels = 