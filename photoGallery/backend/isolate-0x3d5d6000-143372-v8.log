;\n  }\n  return `${StringPrototypeToUpperCase(platform[0])}${StringPrototypeSlice(platform\x2C 1)} ${arch}`;\n}\n\nclass Navigator {\n  // Private properties are used to avoid brand validations.\n  #availableParallelism;\n  #userAgent;\n  #platform;\n  #languages;\n\n  constructor() {\n    if (arguments[0] === kInitialize) {\n      return;\n    }\n    throw new ERR_ILLEGAL_CONSTRUCTOR();\n  }\n\n  /**\n   * @return {number}\n   */\n  get hardwareConcurrency() {\n    this.#availableParallelism ??= getAvailableParallelism();\n    return this.#availableParallelism;\n  }\n\n  /**\n   * @return {string}\n   */\n  get language() {\n    // The default locale might be changed dynamically\x2C so always invoke the\n    // binding.\n    return getDefaultLocale() || 'en-US';\n  }\n\n  /**\n   * @return {Array<string>}\n   */\n  get languages() {\n    this.#languages ??= ObjectFreeze([this.language]);\n    return this.#languages;\n  }\n\n  /**\n   * @return {string}\n   */\n  get userAgent() {\n    this.#userAgent ??= `Node.js/${StringPrototypeSlice(nodeVersion\x2C 1\x2C StringPrototypeIndexOf(nodeVersion\x2C '.'))}`;\n    return this.#userAgent;\n  }\n\n  /**\n   * @return {string}\n   */\n  get platform() {\n    this.#platform ??= getNavigatorPlatform(arch\x2C platform);\n    return this.#platform;\n  }\n}\n\nObjectDefineProperties(Navigator.prototype\x2C {\n  hardwareConcurrency: kEnumerableProperty\x2C\n  language: kEnumerableProperty\x2C\n  languages: kEnumerableProperty\x2C\n  userAgent: kEnumerableProperty\x2C\n  platform: kEnumerableProperty\x2C\n});\n\nmodule.exports = {\n  getNavigatorPlatform\x2C\n  navigator: new Navigator(kInitialize)\x2C\n  Navigator\x2C\n};\n
