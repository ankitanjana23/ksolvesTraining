ction includes(str\x2C search\x2C start) {\n  if (typeof start !== 'number') {\n    start = 0;\n  }\n\n  if (start + search.length > str.length) {\n    return false;\n  } else {\n    return str.indexOf(search\x2C start) !== -1;\n  }\n}\n\ncreateErrorType('ERR_INVALID_OPT_VALUE'\x2C function (name\x2C value) {\n  return 'The value "' + value + '" is invalid for option "' + name + '"'\n}\x2C TypeError);\ncreateErrorType('ERR_INVALID_ARG_TYPE'\x2C function (name\x2C expected\x2C actual) {\n  // determiner: 'must be' or 'must not be'\n  let determiner;\n  if (typeof expected === 'string' && startsWith(expected\x2C 'not ')) {\n    determiner = 'must not be';\n    expected = expected.replace(/^not /\x2C '');\n  } else {\n    determiner = 'must be';\n  }\n\n  let msg;\n  if (endsWith(name\x2C ' argument')) {\n    // For cases like 'first argument'\n    msg = `The ${name} ${determiner} ${oneOf(expected\x2C 'type')}`;\n  } else {\n    const type = includes(name\x2C '.') ? 'property' : 'argument';\n    msg = `The "${name}" ${type} ${determiner} ${oneOf(expected\x2C 'type')}`;\n  }\n\n  msg += `. Received type ${typeof actual}`;\n  return msg;\n}\x2C TypeError);\ncreateErrorType('ERR_STREAM_PUSH_AFTER_EOF'\x2C 'stream.push() after EOF');\ncreateErrorType('ERR_METHOD_NOT_IMPLEMENTED'\x2C function (name) {\n  return 'The ' + name + ' method is not implemented'\n});\ncreateErrorType('ERR_STREAM_PREMATURE_CLOSE'\x2C 'Premature close');\ncreateErrorType('ERR_STREAM_DESTROYED'\x2C function (name) {\n  return 'Cannot call ' + name + ' after a stream was destroyed';\n});\ncreateErrorType('ERR_MULTIPLE_CALLBACK'\x2C 'Callback called multiple times');\ncreateErrorType('ERR_STREAM_CANNOT_PIPE'\x2C 'Cannot pipe\x2C not readable');\ncreateErrorType('ERR_STREAM_WRITE_AFTER_END'\x2C 'write after end');\ncreateErrorType('ERR_STREAM_NULL_VALUES'\x2C 'May not write null values to stream'\x2C TypeError);\ncreateErrorType('ERR_UNKNOWN_ENCODING'\x2C function (arg) {\n  return 'Unknown encoding: ' 