script-source,429,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/node_modules/streamsearch/lib/sbmh.js,'use strict';\n/*\n  Based heavily on the Streaming Boyer-Moore-Horspool C++ implementation\n  by Hongli Lai at: https://github.com/FooBarWidget/boyer-moore-horspool\n*/\nfunction memcmp(buf1\x2C pos1\x2C buf2\x2C pos2\x2C num) {\n  for (let i = 0; i < num; ++i) {\n    if (buf1[pos1 + i] !== buf2[pos2 + i])\n      return false;\n  }\n  return true;\n}\n\nclass SBMH {\n  constructor(needle\x2C cb) {\n    if (typeof cb !== 'function')\n      throw new Error('Missing match callback');\n\n    if (typeof needle === 'string')\n      needle = Buffer.from(needle);\n    else if (!Buffer.isBuffer(needle))\n      throw new Error(`Expected Buffer for needle\x2C got ${typeof needle}`);\n\n    const needleLen = needle.length;\n\n    this.maxMatches = Infinity;\n    this.matches = 0;\n\n    this._cb = cb;\n    this._lookbehindSize = 0;\n    this._needle = needle;\n    this._bufPos = 0;\n\n    this._lookbehind = Buffer.allocUnsafe(needleLen);\n\n    // Initialize occurrence table.\n    this._occ = [\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C needleLen\x2C\n      needleLen\x2C needleLen\x2C needleLen\x2C needleLen\n    ];\n\n    // Populate occurrence table with analysis of the needle\x2C ignoring the last\n    // letter.\n    if (needleLen > 1) {\n      for (let i = 0; i < needleLen - 1; ++i)\n        this._occ[needle[i]] = needleLen - 1 - i;\n    }\n  }\n\n  reset() {\n    this.matches = 0;\n    this._lookbehindSize = 0;\n    this._bufPos = 0;\n  }\n\n  push(chunk\x2C pos) {\n    let result;\n    if (!Buffer.isBuffer(chunk))\n      chunk = Buffer.from(chunk\x2C 'latin1');\n    const chunkLen = chunk.length;\n    this._bufPos = pos || 0;\n    while (result !== chunkLen && this.matches < this.maxMatches)\n      result = feed(this\x2C chunk);\n    return result;\n  }\n\n  destroy() {\n    const lbSize = this._lookbehindSize;\n    if (lbSize)\n      this._cb(false\x2C this._lookbehind\x2C 0\x2C lbSize\x2C false);\n    this.reset();\n  }\n}\n\nfunction feed(self\x2C data) {\n  const len = data.length;\n  const needle = self._needle;\n  const needleLen = needle.length;\n\n  // Positive: points