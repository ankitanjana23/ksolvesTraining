script-source,425,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/node_modules/multer/lib/make-middleware.js,var is = require('type-is')\nvar Busboy = require('busboy')\nvar extend = require('xtend')\nvar appendField = require('append-field')\n\nvar Counter = require('./counter')\nvar MulterError = require('./multer-error')\nvar FileAppender = require('./file-appender')\nvar removeUploadedFiles = require('./remove-uploaded-files')\n\nfunction makeMiddleware (setup) {\n  return function multerMiddleware (req\x2C res\x2C next) {\n    if (!is(req\x2C ['multipart'])) return next()\n\n    var options = setup()\n\n    var limits = options.limits\n    var storage = options.storage\n    var fileFilter = options.fileFilter\n    var fileStrategy = options.fileStrategy\n    var preservePath = options.preservePath\n\n    req.body = Object.create(null)\n\n    var busboy\n\n    try {\n      busboy = Busboy({ headers: req.headers\x2C limits: limits\x2C preservePath: preservePath })\n    } catch (err) {\n      return next(err)\n    }\n\n    var appender = new FileAppender(fileStrategy\x2C req)\n    var isDone = false\n    var readFinished = false\n    var errorOccured = false\n    var pendingWrites = new Counter()\n    var uploadedFiles = []\n\n    function done (err) {\n      if (isDone) return\n      isDone = true\n      req.unpipe(busboy)\n      busboy.removeAllListeners()\n      next(err)\n    }\n\n    function indicateDone () {\n      if (readFinished && pendingWrites.isZero() && !errorOccured) done()\n    }\n\n    function abortWithError (uploadError) {\n      if (errorOccured) return\n      errorOccured = true\n\n      pendingWrites.onceZero(function () {\n        function remove (file\x2C cb) {\n          storage._removeFile(req\x2C file\x2C cb)\n        }\n\n        removeUploadedFiles(uploadedFiles\x2C remove\x2C function (err\x2C storageErrors) {\n          if (err) return done(err)\n\n          uploadError.storageErrors = storageErrors\n          done(uploadError)\n        })\n      })\n    }\n\n    function abortWithCode (code\x2C optionalField) {\n      abortWithError(new MulterError(code\x2C optionalField))\n    }\n\n    // handle text field data\n    busboy.on('field'\x2C function (fieldname\x2C value\x2C { nameTruncated\x2C valueTruncated }) {\n      if (fieldname == null) return abortWithCode('MISSING_FIELD_NAME')\n      if (nameTruncated) return abortWithCode('LIMIT_FIELD_KEY')\n      if (valueTruncated) return abortWithCode('LIMIT_FIELD_VALUE'\x2C fieldname)\n\n      // Work around bug in Busboy (https://github.com/mscdex/busboy/issues/6)\n      if (limits && Object.prototype.hasOwnProperty.call(limits\x2C 'fieldNameSize')) {\n        if (fieldname.length > limits.fieldNameSize) return abortWithCode('LIMIT_FIELD_KEY')\n      }\n\n      appendField(req.body\x2C fieldname\x2C value)\n    })\n\n    // handle files\n    busboy.on('file'\x2C function (fieldname\x2C fileStream\x2C { filename\x2C encoding\x2C mimeType }) {\n      // don't attach to the files object\x2C if there is no file\n      if (!filename) return fileStream.resume()\n\n      // Work around bug in Busboy (https://github.com/mscdex/busboy/issues/6)\n      if (limits && Object.prototype.hasOwnProperty.call(limits\x2C 'fieldNameSize')) {\n        if (fieldname.length > limits.fieldNameSize) return abortWithCode('LIMIT_FIELD_KEY')\n      }\n\n      var file = {\n        fieldname: fieldname\x2C\n        originalname: filename\x2C\n        encoding: encoding\x2C\n        mimetype: mimeType\n      }\n\n      var placeholder = appender.insertPlaceholder(file)\n\n      fileFilter(req\x2C file\x2C function (err\x2C includeFile) {\n        if (err) {\n          appender.removePlaceholder(placeholder)\n          return abortWithError(err)\n        }\n\n        if (!includeFile) {\n          appender.removePlaceholder(placeholder)\n          return fileStream.resume()\n        }\n\n        var aborting = false\n        pendingWrites.increment()\n\n        Object.defineProperty(file\x2C 'stream'\x2C {\n          configurable: true\x2C\n          enumerable: false\x2C\n          value: fileStream\n        })\n\n        fileStream.on('error'\x2C function (err) {\n          pendingWrites.decrement()\n          abortWithError(err)\n        })\n\n        fileStream.on('limit'\x2C function () {\n          aborting = true\n          abortWithCode('LIMIT_FILE_SIZE'\x2C fieldname)\n        })\n\n        storage._handleFile(req\x2C file\x2C function (err\x2C info) {\n          if (aborting) {\n            appender.removePlaceholder(placeholder)\n            uploadedFiles.push(extend(file\x2C info))\n            return pendingWrites.decrement()\n          }\n\n          if (err) {\n            appender.removePlaceholder(placeholder)\n            pendingWrites.decrement()\n            return abortWithError(err)\n          }\n\n          var fileInfo = extend(file\x2C info)\n\n          appender.replacePlaceholder(placeholder\x2C fileInfo)\n          uploadedFiles.push(fileInfo)\n          pendingWrites.decrement()\n          indicateDone()\n        })\n      })\n    })\n\n    busboy.on('error'\x2C function (err) { abortWithError(err) })\n    busboy.on('partsLimit'\x2C function () { abortWithCode('LIMIT_PART_COUNT') })\n    busboy.on('filesLimit'\x2C function () { abortWithCode('LIMIT_FILE_COUNT') })\n    busboy.on('fieldsLimit'\x2C function () { abortWithCode('LIMIT_FIELD_COUNT') })\n    busboy.on('close'\x2C function () {\n      readFinished = true\n      indicateDone()\n    })\n\n    req.pipe(busboy)\n  }\n}\n\nmodule.exports = makeMiddleware\n
