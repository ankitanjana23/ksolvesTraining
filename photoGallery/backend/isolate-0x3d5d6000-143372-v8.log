script-source,385,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/services/imageService.js,const pool = require('../config/db')\n\nconst getAllImages = (pageName\x2CpageSize\x2Csort) =>{\n    return pool.query(\n        `SELECT id\x2C filename FROM images ORDER BY id ${sort} LIMIT $2 OFFSET $1`\x2C\n        [pageName\x2CpageSize]\n      );\n}\n\nconst uploadImage = (originalname\x2Cmimetype\x2Cbuffer) =>{\n    return pool.query(\n        "INSERT INTO images (filename\x2C type\x2C data) VALUES ($1\x2C $2\x2C $3) RETURNING *"\x2C\n        [originalname\x2C mimetype\x2C buffer]\n      );\n}\n\nconst deleteImage = (id) =>{\n    return pool.query("DELETE FROM images WHERE id = $1"\x2C [id]);\n}\n\nconst getImage = (id) =>{\n    return pool.query("SELECT * FROM images WHERE id = $1"\x2C [id]);\n}\nmodule.exports = {getAllImages\x2C uploadImage\x2C deleteImage\x2C getImage}
