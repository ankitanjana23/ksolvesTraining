script-source,295,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/node_modules/winston/lib/winston/common.js,/**\n * common.js: Internal helper and utility functions for winston.\n *\n * (C) 2010 Charlie Robbins\n * MIT LICENCE\n */\n\n'use strict';\n\nconst { format } = require('util');\n\n/**\n * Set of simple deprecation notices and a way to expose them for a set of\n * properties.\n * @type {Object}\n * @private\n */\nexports.warn = {\n  deprecated(prop) {\n    return () => {\n      throw new Error(format('{ %s } was removed in winston@3.0.0.'\x2C prop));\n    };\n  }\x2C\n  useFormat(prop) {\n    return () => {\n      throw new Error([\n        format('{ %s } was removed in winston@3.0.0.'\x2C prop)\x2C\n        'Use a custom winston.format = winston.format(function) instead.'\n      ].join('\\n'));\n    };\n  }\x2C\n  forFunctions(obj\x2C type\x2C props) {\n    props.forEach(prop => {\n      obj[prop] = exports.warn[type](prop);\n    });\n  }\x2C\n  forProperties(obj\x2C type\x2C props) {\n    props.forEach(prop => {\n      const notice = exports.warn[type](prop);\n      Object.defineProperty(obj\x2C prop\x2C {\n        get: notice\x2C\n        set: notice\n      });\n    });\n  }\n};\n
