script-source,457,/home/ankitksi247/Downloads/ksolvesTraining/code/photoGallery/backend/middlewares/checkImageExists.js,const imageService = require('../services/imageService')\n\nconst checkImageExists = async (req\x2C res\x2C next) => {\n  const { id } = req.params;\n  try {\n    const result = await imageService.getImage(id);\n    if (result.rows.length === 0) {\n      return res.status(404).send(`Image not found for id : ${id}`);\n    }\n    req.image = result.rows[0]; //store data\n    next();\n  } catch (err) {\n    next(err);\n  }\n};\n\nmodule.exports = checkImageExists;\n
